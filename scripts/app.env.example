# 배포 시 GitHub Actions secrets으로 주입되는 값 목록입니다.
# Settings > Secrets and variables > Actions 에 등록하세요.
#
# 컨테이너 레지스트리(GHCR) 인증은 워크플로가 GITHUB_TOKEN으로 자동 처리하므로
# 등록할 시크릿이 없습니다.

### 서버 접속 (필수) ###
EC2_HOST=<EC2 퍼블릭 IP 또는 도메인>
EC2_USERNAME=ubuntu
EC2_SSH_KEY=<EC2 접속 PEM 키 전문>

### 데이터베이스 (필수) ###
DATABASE_HOST=<host>
DATABASE_USERNAME=<user>
DATABASE_PASSWORD=<password>

### 인증 (필수) ###
# openssl rand -base64 64 | tr -d '\n' 로 생성한다.
# tr을 빼면 openssl이 64자마다 줄바꿈을 넣어 2줄로 출력되고,
# 그 줄바꿈 때문에 기동 시 base64 디코딩이 실패한다(Illegal base64 character).
APP_JWT_SECRET=<base64-encoded-hmac-secret-한-줄>
GOOGLE_CLIENT_ID=<google-oauth-client-id>
GOOGLE_OAUTH_CLIENT_SECRET=<google-oauth-client-secret>
# 아래 두 값은 소셜 로그인 성공 후 돌아갈 프론트 URL이며 둘 다 필수다.
# EXTRA_INFO_URL은 가입(UNREGISTER) 사용자만 타는 경로라, 빠뜨려도 기존 회원 로그인은
# 정상으로 보이고 신규 가입/재가입만 조용히 막힌다. 반드시 등록할 것.
OAUTH2_REDIRECT_SUCCESS_URL=https://example.com/oauth2/redirect
EXTRA_INFO_URL=https://example.com/extra-info

# 아래 두 값은 release.yml에 하드코딩되어 있습니다 (secrets 불필요):
#   APP_JWT_ACCESS_TOKEN_EXPIRATION_SECONDS=3600
#   APP_JWT_REFRESH_TOKEN_EXPIRATION_SECONDS=1209600

### 선택 ###
# 브라우저에서 호출하는 프론트엔드 도메인 (콤마 구분).
# 미설정 시 localhost만 허용됩니다.
APP_CORS_ALLOWED_ORIGINS=https://app.example.com

# 오늘의 추천 투표를 설정할 수 있는 user id 목록 (콤마 구분).
# 미설정 시 아무도 설정할 수 없습니다.
ADMIN_USER_IDS=1

# 이미지 업로드 (미설정 시 이미지 기능만 비활성화되고 서버는 정상 기동)
AWS_S3_BUCKET=<bucket>
AWS_S3_REGION=ap-northeast-2
AWS_S3_ACCESS_KEY=<access-key>
AWS_S3_SECRET_KEY=<secret-key>

# 푸시 알림 (서비스 계정 JSON 전문)
FIREBASE_SERVICE_ACCOUNT_JSON=<service-account-json>

# AI 요약 / 분석 연동 (미설정 시 no-op)
GEMINI_PROJECT_ID=<gcp-project-id>
GEMINI_ENABLED=false
GA_ENABLED=false
GA_MEASUREMENT_ID=<G-XXXXXXX>
GA_API_SECRET=<api-secret>
AMPLITUDE_ENABLED=false
AMPLITUDE_API_KEY=<api-key>
